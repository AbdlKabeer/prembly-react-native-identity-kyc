{
  "name": "prembly-react-native-kyc",
  "version": "2.0.0",
  "description": "Prembly React Native SDK: the Identity KYC widget and Transaction Monitoring device signals, with a real device ID read from the phone",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "prembly-react-native-kyc-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "example": "npm run --workspace prembly-react-native-kyc-example"
  },
  "keywords": [
    "react-native",
    "prembly",
    "kyc",
    "identity",
    "fraud",
    "device"
  ],
  "author": "Prembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdlKabeer/prembly-react-native-identity-kyc.git"
  },
  "homepage": "https://github.com/AbdlKabeer/prembly-react-native-identity-kyc#readme",
  "bugs": {
    "url": "https://github.com/AbdlKabeer/prembly-react-native-identity-kyc/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0",
    "react-native-webview": ">=13.0.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "jest": "^30.5.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.1",
    "react-native-webview": "^13.16.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "PremblyDeviceSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.prembly.device"
    }
  }
}
